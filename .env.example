# Backend only. Never prefix secrets with VITE_ or commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require
CHAT_ACCESS_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
WORKER_ADDRESS=RUNPOD_PUBLIC_IP:MAPPED_TCP_PORT
ALLOWED_ORIGINS=http://127.0.0.1:5173
TLS_CA_FILE=/private/path/ca.crt
TLS_CLIENT_CERT_FILE=/private/path/client.crt
TLS_CLIENT_KEY_FILE=/private/path/client.key
# Worker uses TLS_CA_FILE, TLS_SERVER_CERT_FILE, TLS_SERVER_KEY_FILE.
# Cloud deployment can use each variable with _B64 instead of _FILE.
