# Backend only. Never prefix secrets with VITE_ or commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
CHAT_ACCESS_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
RUNPOD_ENDPOINT_URL=https://ENDPOINT_ID.api.runpod.ai
RUNPOD_API_KEY=REPLACE_WITH_ENDPOINT_API_KEY
WORKER_SERVICE_KEY=REPLACE_WITH_DIFFERENT_RANDOM_32_CHARACTER_SECRET
ALLOWED_ORIGINS=http://127.0.0.1:5173
MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507
# Optional: enables isolated terminal/Python tools. Backend only; never pass into a sandbox.
E2B_API_KEY=
# Set all three to enable the durable path. Leave ADDRESS empty for the legacy rollback path.
# Cloud uses TLS; use 127.0.0.1:7233 with namespace default for local development.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
# Worker requires WORKER_SERVICE_KEY, MODEL_NAME, PORT=80 and the configured model cache.
